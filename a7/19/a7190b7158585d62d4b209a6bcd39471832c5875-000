# 6. Animation Canon
def get_line_scale_opacity(t_local, line_idx):
    start = 0.0 if line_idx == 0 else 0.67
    end = 2.90
    pop_duration = 0.30
    fade_out = 0.35
    if t_local < start or t_local > end:
        return 0.50, 0.0
    elapsed = t_local - start
    if elapsed < pop_duration:
        p = clamp(elapsed / pop_duration)
        if p < 0.18:
            scale = 0.50 + (1.02 - 0.50) * smoothstep(p / 0.18)
        elif p < 0.34:
            scale = 1.02 + (1.18 - 1.02) * smoothstep((p - 0.18) / 0.16)
        elif p < 0.70:
            scale = 1.18 + (0.98 - 1.18) * smoothstep((p - 0.34) / 0.36)
        else:
            scale = 0.98 + (1.00 - 0.98) * smoothstep((p - 0.70) / 0.30)
        opacity = smoothstep(min(1.0, p / 0.18))
    else:
        scale = 1.00
        opacity = 1.00
        
    fade_start = end - fade_out
    if t_local > fade_start:
        opacity *= smoothstep((end - t_local) / fade_out)
    return scale, opacity

def transform_layer(layer, bbox, scale, opacity):
    if opacity <= 0.001:
        return None
    if bbox is None:
        return None
    crop = layer.crop(bbox)
    cx = (bbox[0] + bbox[2]) / 2.0
    cy = (bbox[1] + bbox[3]) / 2.0
    nw = max(1, int(round(crop.width * scale)))
    nh = max(1, int(round(crop.height * scale)))
    resized = crop.resize((nw, nh), Image.Resampling.LANCZOS)
    if opacity < 0.999:
        alpha = resized.getchannel("A").point(lambda p: int(p * opacity))
        resized.putalpha(alpha)
    px = int(round(cx - nw / 2.0))
    py = int(round(cy - nh / 2.0))
    return resized, (px, py)

