def clamp(v, v_min=0.0, v_max=1.0):
    return max(v_min, min(v_max, v))

def smoothstep(v):
    v = clamp(v)
    return v * v * (3.0 - 2.0 * v)

def baseline_y(draw, font, top_y):
    bb = draw.textbbox((0, 0), "Hgj", font=font, anchor="ls")
    return top_y - bb[1]

# 2. Titre Style V4 : GT Sectra Bold Caps
def build_title_layer():
    font_line1 = ImageFont.truetype(p_gt, int(round(170 * 1.25))) # ~212
    font_line2 = ImageFont.truetype(p_gt, int(round(62 * 1.25)))  # ~78
    
    mask = Image.new("L", (W, H), 0)
    draw = ImageDraw.Draw(mask)
    
    # Ligne 1 : HOUDINI
    line1 = "HOUDINI"
    tracking = font_line1.size * 0.10
    chars1 = list(line1)
    widths1 = [draw.textlength(c, font=font_line1) for c in chars1]
    w1 = sum(widths1) + tracking * (len(chars1) - 1)
    x1 = (W - w1) / 2.0
    y1 = 540
    base_y1 = baseline_y(draw, font_line1, y1)
    cur_x = x1
    for i, c in enumerate(chars1):
        draw.text((cur_x, base_y1), c, font=font_line1, fill=255, anchor="ls")
        cur_x += widths1[i] + tracking
        
    # Ligne 2 : PROCEDURAL CHURCH (justifié à w1)
    line2 = "PROCEDURAL CHURCH"
    words = line2.split(" ")
    w_chars = []
    total_chars_w = 0
    num_letter_gaps = 0
    for w in words:
        chars = list(w)
        cw = [draw.textlength(c, font=font_line2) for c in chars]
        w_chars.append((chars, cw))
        total_chars_w += sum(cw)
        num_letter_gaps += len(chars) - 1
    num_word_gaps = len(words) - 1
    denom = num_letter_gaps + 2.20 * num_word_gaps
    letter_tr = (w1 - total_chars_w) / denom if denom > 0 else 0
    word_sp = letter_tr * 2.20
    
    y2 = 715
    base_y2 = baseline_y(draw, font_line2, y2)
    cur_x = x1
    for wi, (chars, cw) in enumerate(w_chars):
        for ci, c in enumerate(chars):
            draw.text((cur_x, base_y2), c, font=font_line2, fill=255, anchor="ls")
            cur_x += cw[ci] + letter_tr
        if wi < num_word_gaps:
            cur_x += word_sp - letter_tr
            
    # Ombre noire Style V4 (offset 16, blur 10)
    shadow_mask = Image.new("L", (W, H), 0)
    shadow_mask.paste(mask, (16, 16))
    shadow_mask = shadow_mask.filter(ImageFilter.GaussianBlur(10))
    
    layer = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    shadow = Image.new("RGBA", (W, H), (0, 0, 0, 230))
    shadow.putalpha(shadow_mask)
    layer.alpha_composite(shadow)
    
    white = Image.new("RGBA", (W, H), (255, 255, 255, 255))
    white.putalpha(mask)
    layer.alpha_composite(white)
    return layer

