def render_subtitle_line(text, y_pos):
    cur_size = 115
    im_dummy = Image.new("L", (10, 10), 0)
    d_dummy = ImageDraw.Draw(im_dummy)
    
    # Auto-fit pour eviter tout debordement d ecran
    while cur_size >= 70:
        f_cur_sub = ImageFont.truetype(p_garamond, cur_size)
        f_cur_mono = ImageFont.truetype(p_mono, cur_size)
        w_space = int(32 * (cur_size / 115.0))
        words = text.split(" ")
        tot_w = 0
        mono_char_w = f_cur_mono.getlength("M")
        for wi, w in enumerate(words):
            if "ᕙ" in w or "ᕗ" in w or "▿" in w:
                tot_w += mono_char_w * len(w)
            else:
                tot_w += d_dummy.textlength(w, font=f_cur_sub)
            if wi < len(words) - 1:
                tot_w += w_space
        if tot_w <= 1860:
            break
        cur_size -= 2
        
    f_sub = ImageFont.truetype(p_garamond, cur_size)
    f_mono = ImageFont.truetype(p_mono, cur_size)
    f_euphemia = ImageFont.truetype(p_euphemia, cur_size)
    f_arial = ImageFont.truetype(p_arial, cur_size)
    word_space = int(32 * (cur_size / 115.0))
    mono_w = f_mono.getlength("M")
    
    char_fonts = {
        "ᕙ": f_euphemia,
        "(": f_mono,
        "`": f_mono,
        "▿": f_arial,
        "´": f_mono,
        ")": f_mono,
        "ᕗ": f_euphemia,
    }
    
    mask = Image.new("L", (W, H), 0)
    draw = ImageDraw.Draw(mask)
    words = text.split(" ")
    
    cur_x = (W - tot_w) / 2.0
    base_y = baseline_y(draw, f_sub, y_pos)
    
    for wi, w in enumerate(words):
        if "ᕙ" in w or "ᕗ" in w or "▿" in w:
            for c in w:
                cf = char_fonts.get(c, f_mono)
                cw = draw.textlength(c, font=cf)
                x_off = cur_x + (mono_w - cw) / 2.0
                draw.text((x_off, base_y), c, font=cf, fill=255, anchor="ls")
                cur_x += mono_w
        else:
            w_len = draw.textlength(w, font=f_sub)
            draw.text((cur_x, base_y), w, font=f_sub, fill=255, anchor="ls")
            cur_x += w_len
        if wi < len(words) - 1:
            cur_x += word_space
            
    # Ombre portee Style V4 (offset 20, blur 12)
    shadow_mask = Image.new("L", (W, H), 0)
    shadow_mask.paste(mask, (20, 20))
    shadow_mask = shadow_mask.filter(ImageFilter.GaussianBlur(12))
    
    layer = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    shadow = Image.new("RGBA", (W, H), (0, 0, 0, 230))
    shadow.putalpha(shadow_mask)
    layer.alpha_composite(shadow)
    
    white = Image.new("RGBA", (W, H), (255, 255, 255, 255))
    white.putalpha(mask)
    layer.alpha_composite(white)
    
    bbox = layer.getbbox()
    return layer, bbox

